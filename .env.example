# Telefon uzerindeki MariaDB'ye baglanti (Tailscale). Bu dosyayi .env olarak kopyalayip
# degerleri doldurun; .env depoya girmez. Veritabani kapaliyken de boru hatti calisir:
# okuyucular once phonedb_cache/ onbellegine bakar (py tools/local_backup.py restore).
NBA_DB_HOST=
NBA_DB_PORT=3306
NBA_DB_NAME=phonedb
NBA_DB_USER=
NBA_DB_PASSWORD=
