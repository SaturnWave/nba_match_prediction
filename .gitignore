# eski modellerin yerel yedekleri (git gecmisinde zaten var)
models/backup_*/


# sezon simulatorunun kum havuzu: tahmin kosulari (forecast_*) depoda durur ki dashboard'un
# Sim Sezon sekmesi klondan sonra da calissin; kalibrasyon ve geriye donuk test kosulari yerel kalir
sim_sandbox/*
!sim_sandbox/forecast_*/

# Yukarida yok sayilan onbellekler (phonedb_cache/, matchup_cache_v1.pkl, team_box_cache_v1.pkl,
# defensive_tracking_cache_v1.pkl, graphify-out/, *.log) sikistirilmis halde local_backup/ altinda
# depodadir; klondan sonra:  py tools/local_backup.py restore
